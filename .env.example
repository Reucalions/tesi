# Modello di configurazione: copialo in .env e compila i valori per il run CAMEL.
# La modalità fixtures e l'esportazione degli schemi non richiedono credenziali.
# La CLI conserva le variabili già definite nella shell, anche se sono presenti qui.
# Modello che supporta tool calling e output JSON. Nessun modello implicito.
LLM_MODEL=
# Credenziale del provider scelto. Se vuota, il codice prova OPENAI_API_KEY nell'ambiente.
# Non inserire una chiave reale in questo file di esempio versionato.
LLM_API_KEY=
# Lascia vuoto per il backend OpenAI di CAMEL, oppure specifica un endpoint /v1.
LLM_BASE_URL=
# Timeout di una richiesta al backend, in secondi: >0 e <=600.
# Non è il limite dell'intero run; gli agenti e la Workforce hanno timeout propri.
LLM_TIMEOUT_SECONDS=120
# Opzionale, da 0 a 2. Per la prova Ollama usare 0; vuoto non invia il parametro.
LLM_TEMPERATURE=
# Opzionale: massimo di token generati per risposta, non dimensione del contesto.
# Per le prove Ollama usare 2048; vuoto non invia il parametro al provider.
LLM_MAX_TOKENS=
# Per un server locale senza autenticazione, usa una chiave fittizia esplicita.
# LLM_API_KEY=local
# LLM_BASE_URL=http://localhost:11434/v1
